{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Unemployment rate by state and territory, August 2026 (trend)",
  "width": 500,
  "height": 400,
  "projection": {"type": "equalEarth", "rotate": [-134, 0]},
  "data": {
    "url": "",
    "format": {"type": "topojson", "feature": "ne_10m_admin_1_states_provinces"}
  },
  "transform": [
    {
      "lookup": "properties.name",
      "from": {
        "data": {"url": "https://raw.githubusercontent.com/chenulpunchihewa/fit3179-dv2/refs/heads/main/data/labour_force_by_state_aug2026_trend.csv"},
        "key": "state",
        "fields": ["unemployment_rate_pct"]
      }
    }
  ],
  "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 1},
  "encoding": {
    "color": {
      "field": "unemployment_rate_pct",
      "type": "quantitative",
      "title": "Unemployment rate (%)",
      "scale": {"scheme": "blues", "domain": [3.5, 5.5]},
      "legend": {"orient": "bottom-left", "values": [4.0, 4.5, 5.0], "format": ".1f", "gradientLength": 160}
    },
    "tooltip": [
      {"field": "properties.name", "type": "nominal", "title": "State or territory"},
      {"field": "unemployment_rate_pct", "type": "quantitative", "title": "Unemployment rate (%)"}
    ]
  },
  "config": {"view": {"stroke": null}}
}