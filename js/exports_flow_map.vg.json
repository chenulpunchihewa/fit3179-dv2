{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Australia's goods exports to its top 15 destinations, 2025",
  "width": 620,
  "height": 320,
  "projection": {"type": "equalEarth", "rotate": [-134, 0]},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/chenulpunchihewa/fit3179-dv2/refs/heads/main/data/world_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "transform": [
        {"filter": "datum.properties.NAME != 'Antarctica'"}
      ],
      "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.5},
      "encoding": {
        "fill": {
          "condition": {"test": "datum.properties.NAME == 'Australia'", "value": "#b0b8c2"},
          "value": "#e6e6e6"
        }
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/chenulpunchihewa/fit3179-dv2/refs/heads/main/data/exports_top_destinations_2025.csv"
      },
      "mark": {"type": "rule", "opacity": 0.6, "color": "#2166ac"},
      "encoding": {
        "longitude": {"field": "origin_lon", "type": "quantitative"},
        "latitude": {"field": "origin_lat", "type": "quantitative"},
        "longitude2": {"field": "lon"},
        "latitude2": {"field": "lat"},
        "strokeWidth": {
          "field": "exports_aud_bn",
          "type": "quantitative",
          "title": "Exports (A$ billion)",
          "scale": {"domain": [0, 180], "range": [0, 14]},
          "legend": {
            "values": [10, 50, 100, 175],
            "orient": "bottom-left",
            "symbolType": "stroke",
            "symbolStrokeColor": "#2166ac"
          }
        },
        "order": {"field": "exports_aud_bn", "type": "quantitative", "sort": "descending"},
        "tooltip": [
          {"field": "destination", "type": "nominal", "title": "Destination"},
          {"field": "exports_aud_bn", "type": "quantitative", "title": "Exports (A$ billion)", "format": ".1f"},
          {"field": "share_of_total_pct", "type": "quantitative", "title": "Share of total exports (%)"}
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/chenulpunchihewa/fit3179-dv2/refs/heads/main/data/exports_top_destinations_2025.csv"
      },
      "mark": {"type": "circle", "color": "#2166ac", "size": 30, "opacity": 0.9},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "tooltip": [
          {"field": "destination", "type": "nominal", "title": "Destination"},
          {"field": "exports_aud_bn", "type": "quantitative", "title": "Exports (A$ billion)", "format": ".1f"},
          {"field": "share_of_total_pct", "type": "quantitative", "title": "Share of total exports (%)"}
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/chenulpunchihewa/fit3179-dv2/refs/heads/main/data/exports_top_destinations_2025.csv"
      },
      "transform": [
        {"filter": "datum.destination == 'Japan' || datum.destination == 'United States' || datum.destination == 'United Kingdom'"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 8, "fontSize": 12, "color": "#333333"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "destination", "type": "nominal"}
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/chenulpunchihewa/fit3179-dv2/refs/heads/main/data/exports_top_destinations_2025.csv"
      },
      "transform": [
        {"filter": "datum.destination == 'China'"}
      ],
      "mark": {"type": "text", "align": "right", "dx": -8, "fontSize": 12, "color": "#333333"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "destination", "type": "nominal"}
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/chenulpunchihewa/fit3179-dv2/refs/heads/main/data/exports_top_destinations_2025.csv"
      },
      "transform": [
        {"filter": "datum.destination == 'South Korea' || datum.destination == 'India'"}
      ],
      "mark": {"type": "text", "align": "center", "dy": -13, "fontSize": 12, "color": "#333333"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "destination", "type": "nominal"}
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/chenulpunchihewa/fit3179-dv2/refs/heads/main/data/exports_top_destinations_2025.csv"
      },
      "transform": [
        {"filter": "datum.rank == 1"}
      ],
      "mark": {"type": "text", "align": "center", "dy": 26, "fontSize": 12, "fontWeight": "bold", "color": "#333333"},
      "encoding": {
        "longitude": {"field": "origin_lon", "type": "quantitative"},
        "latitude": {"field": "origin_lat", "type": "quantitative"},
        "text": {"value": "Australia"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}