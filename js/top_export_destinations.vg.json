{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Step 1: a plain bar chart of goods exports by destination, 2025",
  "width": 520,
  "height": 340,
  "data": {
    "url": "data/exports_top_destinations_2025.csv"
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "destination",
      "type": "nominal",
      "title": "Destination"
    },
    "y": {
      "field": "exports_aud_bn",
      "type": "quantitative",
      "title": "Goods exports in 2025 (A$ billion)"
    }
  }
}
