{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Of every 100 Australians aged 15 and over, how many are in a job, unemployed or not in the labour force, August 2026",
  "width": 320,
  "height": 360,
  "data": {"sequence": {"start": 0, "stop": 100, "as": "person"}},
  "transform": [
    {"calculate": "'Australia'", "as": "state"},
    {
      "lookup": "state",
      "from": {
        "data": {"url": "https://raw.githubusercontent.com/chenulpunchihewa/fit3179-dv2/refs/heads/main/data/labour_force_by_state_aug2026_trend.csv"},
        "key": "state",
        "fields": ["employment_ratio_pct", "participation_rate_pct"]
      }
    },
    {"calculate": "round(datum.employment_ratio_pct)", "as": "employed"},
    {"calculate": "round(datum.participation_rate_pct)", "as": "in_labour_force"},
    {
      "calculate": "datum.person < datum.employed ? 'In a job' : datum.person < datum.in_labour_force ? 'Unemployed and looking for work' : 'Not in the labour force'",
      "as": "status"
    },
    {"calculate": "datum.person % 10", "as": "col"},
    {"calculate": "floor(datum.person / 10)", "as": "row"}
  ],
  "mark": {
    "type": "point",
    "filled": true,
    "opacity": 1,
    "size": 420,
    "shape": "M0,-1 a0.3,0.3 0 1,0 0.0001,0 Z M-0.55,-0.5 h1.1 v0.9 h-0.3 v0.9 h-0.2 v-0.9 h-0.2 v0.9 h-0.2 v-0.9 h-0.3 Z"
  },
  "encoding": {
    "x": {"field": "col", "type": "ordinal", "axis": null},
    "y": {"field": "row", "type": "ordinal", "axis": null},
    "color": {
      "field": "status",
      "type": "nominal",
      "title": "Of every 100 Australians aged 15+",
      "scale": {
        "domain": ["In a job", "Unemployed and looking for work", "Not in the labour force"],
        "range": ["#2166ac", "#b2182b", "#bdbdbd"]
      },
      "legend": {"titleLimit": 300, "labelLimit": 260, "labelFontSize": 12, "titleFontSize": 12}
    }
  },
  "config": {"view": {"stroke": null}}
}