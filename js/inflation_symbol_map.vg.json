{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Annual inflation by capital city, August 2026",
  "width": 520,
  "height": 400,
  "projection": {"type": "equalEarth", "rotate": [-134, 0]},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/chenulpunchihewa/fit3179-dv2/refs/heads/main/data/australia_states.topojson",
        "format": {"type": "topojson", "feature": "ne_10m_admin_1_states_provinces"}
      },
      "transform": [
        {"filter": "datum.properties.name != 'Macquarie Island' && datum.properties.name != 'Lord Howe Island'"}
      ],
      "mark": {"type": "geoshape", "fill": "#e6e6e6", "stroke": "white"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/chenulpunchihewa/fit3179-dv2/refs/heads/main/data/cpi_capital_cities_aug2026.csv"
      },
      "transform": [
        {
          "calculate": "datum.cpi_annual_change_pct_aug2026 > datum.national_cpi_annual_change_pct_aug2026 ? 'Above national rate' : 'Below national rate'",
          "as": "vs_national"
        }
      ],
      "mark": {"type": "circle", "opacity": 0.85, "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "cpi_annual_change_pct_aug2026",
          "type": "quantitative",
          "title": "Inflation (annual % change)",
          "scale": {"domain": [0, 5], "range": [0, 700]},
          "legend": {
            "values": [3, 4, 5],
            "orient": "top",
            "direction": "horizontal",
            "symbolFillColor": "#999999",
            "symbolStrokeColor": "#999999"
          }
        },
        "color": {
          "field": "vs_national",
          "type": "nominal",
          "title": "Compared with national (4.0%)",
          "scale": {
            "domain": ["Above national rate", "Below national rate"],
            "range": ["#b2182b", "#2166ac"]
          },
          "legend": {"orient": "top", "direction": "horizontal"}
        },
        "tooltip": [
          {"field": "city", "type": "nominal", "title": "City"},
          {"field": "cpi_annual_change_pct_aug2026", "type": "quantitative", "title": "Inflation (annual % change)"},
          {"field": "national_cpi_annual_change_pct_aug2026", "type": "quantitative", "title": "National rate (%)"}
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/chenulpunchihewa/fit3179-dv2/refs/heads/main/data/cpi_capital_cities_aug2026.csv"
      },
      "transform": [
        {"filter": "datum.city == 'Sydney' || datum.city == 'Brisbane' || datum.city == 'Hobart' || datum.city == 'Darwin' || datum.city == 'Perth'"},
        {"calculate": "datum.city + ' ' + format(datum.cpi_annual_change_pct_aug2026, '.1f') + '%'", "as": "label"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 20, "fontSize": 12, "color": "#333333"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/chenulpunchihewa/fit3179-dv2/refs/heads/main/data/cpi_capital_cities_aug2026.csv"
      },
      "transform": [
        {"filter": "datum.city == 'Adelaide' || datum.city == 'Melbourne'"},
        {"calculate": "datum.city + ' ' + format(datum.cpi_annual_change_pct_aug2026, '.1f') + '%'", "as": "label"}
      ],
      "mark": {"type": "text", "align": "right", "dx": -20, "fontSize": 12, "color": "#333333"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/chenulpunchihewa/fit3179-dv2/refs/heads/main/data/cpi_capital_cities_aug2026.csv"
      },
      "transform": [
        {"filter": "datum.city == 'Canberra'"},
        {"calculate": "datum.city + ' ' + format(datum.cpi_annual_change_pct_aug2026, '.1f') + '%'", "as": "label"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 16, "dy": 12, "fontSize": 12, "color": "#333333"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}