{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Placeholder",
  "width": 400,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/chenulpunchihewa/fit3179-dv2/refs/heads/main/data/gva_industry_growth_jun2026.csv"
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "quarterly_growth_pct",
      "type": "quantitative",
      "title": "% change on the previous quarter"
    },
    "y": {
      "field": "industry",
      "type": "nominal",
      "title": "Industry",
      "sort": {"field": "quarterly_growth_pct", "order": "descending"},
      "axis": {"labelLimit": 300}
    },
    "color": {
        "condition": {"test": "datum.quarterly_growth_pct < 0", "value": "#b2182b"},
        "value": "#2166ac"
    }
  }
}
